year = years,
team_abbr = teams
) %>%
mutate(
salary_data = map2(
team_abbr,
year,
possibly(
~ sptrc_team_active_payroll(
team_abbr = .x,
year = .y
),
otherwise = tibble()
)
)
) %>%
select(-team_abbr) %>%
unnest(salary_data)
