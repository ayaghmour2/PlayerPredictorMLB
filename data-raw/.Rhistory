#' Calculate Win Percentage
#'
#' Calculates a team's win percentage using its number of wins and losses.
#'
#' @param W A non-negative numeric value representing the number of wins.
#' @param L A non-negative numeric value representing the number of losses.
#'
#' @return A numeric value representing the team's win percentage.
#'
#' @examples
#' calculate_win_percentage(90, 72)
#' calculate_win_percentage(c(90, 80), c(72, 82))
#'
#' @export
calculate_win_percentage <- function(W, L) {
if (!is.numeric(W) || !is.numeric(L)) {
stop("W and L must be numeric.")
}
if (any(is.na(W)) || any(is.na(L))) {
stop("W and L cannot contain missing values.")
}
if (any(W < 0) || any(L < 0)) {
stop("W and L must be non-negative.")
}
if (any(W + L == 0)) {
stop("The total number of games must be greater than zero.")
}
W / (W + L)
}
#' Calculate Expected Record
#'
#' Calculates a team's expected winning percentage using runs scored
#' and runs allowed. The calculation uses the Pythagorean expectation
#' formula with an exponent of 2.
#'
#' @param RS A non-negative numeric value representing runs scored.
#' @param RA A non-negative numeric value representing runs allowed.
#'
#' @return A numeric value representing the team's expected winning
#'   percentage.
#'
#' @examples
#' calculate_expected_record(800, 700)
#' calculate_expected_record(c(800, 750), c(700, 775))
#'
#' @export
calculate_expected_record <- function(RS, RA) {
if (!is.numeric(RS) || !is.numeric(RA)) {
stop("RS and RA must be numeric.")
}
if (any(is.na(RS)) || any(is.na(RA))) {
stop("RS and RA cannot contain missing values.")
}
if (any(RS < 0) || any(RA < 0)) {
stop("RS and RA must be non-negative.")
}
if (any(RS == 0 & RA == 0)) {
stop("RS and RA cannot both equal zero.")
}
RS^2 / (RS^2 + RA^2)
}
