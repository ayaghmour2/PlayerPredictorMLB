)
## There appear to be major outliers in 2020 and 2021. Identify them.
max_fatality <- data %>%
filter(year %in% c(2020, 2021)) %>%
group_by(year) %>%
summarise(
max_fatality_rate = max(fatality_rate, na.rm = TRUE),
country = countryterritoryCode[which.max(fatality_rate)]
)
## View the result
print(max_fatality)
## Create a Subset with just Liechtenstein (LIE) and Greece (GRC)
lie_grc <- data %>%
filter(countryterritoryCode %in% c("LIE", "GRC"))
## Yearly Statistics
lie_grc_stats <- lie_grc %>%
group_by(countryterritoryCode, year) %>%
summarise(
total_cases = sum(cases, na.rm = TRUE),
total_deaths = sum(deaths, na.rm = TRUE)
) %>%
arrange(countryterritoryCode, year)
## Print the Findings
print(lie_grc_stats)
## Examine Stats for the Top Five Fatality Rates Each Year
top_five_table <- data %>%
group_by(as.factor(year)) %>%
arrange(desc(fatality_rate), .by_group = TRUE) %>%
slice(1:5) %>%
summarise(
country = countryterritoryCode,
total_cases = sum(cases, na.rm = TRUE),
total_deaths = sum(deaths, na.rm = TRUE),
fatality_rate = fatality_rate
)
## Print the Table
print(top_five_table)
## Identify the countires with the most deaths
top_five_deaths <- data %>%
group_by(countryterritoryCode) %>%
summarise(total_deaths = sum(deaths, na.rm = TRUE)) %>%
arrange(desc(total_deaths)) %>%
slice(1:5)
## Print the results
print(top_five_deaths)
## Create statistics based on these five countries
top_countries_yearly <- data %>%
filter(countryterritoryCode %in% top_five_deaths$countryterritoryCode) %>%
group_by(countryterritoryCode, year) %>%
summarise(
total_cases = sum(cases, na.rm = TRUE),
total_deaths = sum(deaths, na.rm = TRUE),
population = mean(popData2020),
fatality_rate_100k = (total_deaths / population) * 100000
) %>%
arrange(-fatality_rate_100k)
## View the yearly statistics for the top five countries
print(top_countries_yearly)
## Select two random countries for analysis using seed(222)
set.seed(222)
## Randomly select two countries
random_countries <- sample(data$countryterritoryCode, size = 2, replace = FALSE)
## View the selected countries
print(random_countries)
## SWE CYP
## Create a dataframe for just those two countries
sweden_cyprus_data <- data %>%
filter(countryterritoryCode %in% c("SWE", "CYP"))
## Create a scatterplot to display the relationship between Sweden and Cyprus
ggplot(sweden_cyprus_data, aes(x = cases, y = deaths, color = as.factor(year))) +
geom_point(size = 3, alpha = 0.7) +
labs(
title = "Relationship Between Cases and Deaths for Sweeden and Cyprus",
x = "Total Cases",
y = "Total Deaths",
color = "Year"
) +
theme_minimal()
## Create summary statistics
summary_stats <- sweden_cyprus_data %>%
group_by(countryterritoryCode, year) %>%
summarise(
total_cases = sum(cases, na.rm = TRUE),
total_deaths = sum(deaths, na.rm = TRUE),
mean_cases = mean(cases, na.rm = TRUE),
mean_deaths = mean(deaths, na.rm = TRUE),
max_cases = max(cases, na.rm = TRUE),
max_deaths = max(deaths, na.rm = TRUE),
min_cases = min(cases, na.rm = TRUE),
min_deaths = min(deaths, na.rm = TRUE)
)
## View the summary statistics
print(summary_stats)
## Create a new variable 'month_year' combining month and year
sweden_cyprus_data <- sweden_cyprus_data %>%
mutate(year_month = paste(year, month, sep = "-"))
## Compare Incidence Rates
ggplot(sweden_cyprus_data, aes(x = year_month, y = incidence_rate, color = countryterritoryCode)) +
geom_point(size = 3, alpha = 0.7) +
labs(
title = "Incidence Rates for Sweden and Cyprus by Month and Year",
x = "Month",
y = "Incidence Rate",
color = "Country"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
## Incidence Rates do not seem to be normally distributed. This can be displayed
## with a historgram
ggplot(sweden_cyprus_data, aes(x = incidence_rate)) +
geom_histogram(bins = 30, fill = "blue", alpha = 0.7, color = "black") +
labs(
title = "Comparison of Incidence Rates for Sweden and Cyprus",
x = "Incidence Rate",
y = "Frequency"
) +
facet_wrap(~ countryterritoryCode, ncol = 2) +
theme_minimal()
## Since the distribution isn't normal, we can test if the variance is normal
## Using the textbook, we can use a Mann Whitney U-Test to Compare Means
## The two samples are independent
## H0: The populations are identical
## HA: The populations aren't identical
## Alpha Value: 0.01
mann_whitney_results <- wilcox.test(incidence_rate ~ countryterritoryCode, data = sweden_cyprus_data)
## Print the Results
print(mann_whitney_results)
## Interpret the Results
## Since the p-value is less then 0, we reject the null hypothesis
## This would suggest the two means are different
## Aggregate the data and remove any unneeded or missing values
aggregated_data <- data %>%
select(incidence_rate, fatality_rate) %>%
na.omit()
## Histogram of Incidence Rate
ggplot(aggregated_data, aes(x = incidence_rate)) +
geom_histogram(bins = 30, fill = "blue", color = "black", alpha = 0.7) +
labs(
title = "Distribution of Daily Incidence Rates",
x = "Incidence Rate",
y = "Frequency"
) +
theme_minimal()
## Histogram of Fatality Rate
ggplot(aggregated_data, aes(x = fatality_rate)) +
geom_histogram(bins = 30, fill = "red", color = "black", alpha = 0.7) +
labs(
title = "Distribution of Daily Fatality Rates",
x = "Fatality Rate",
y = "Frequency"
) +
theme_minimal()
## Both datasets are skewed right
## Next we will test for correlation
## We will use a p-value of 0.01
## H0: There is no correlation
## HA: There is a correlation
## With non-normal data, we will use Spearman's Rank Correlation according to
## the textbook
correlation <- cor.test(aggregated_data$incidence_rate, aggregated_data$fatality_rate, method = "spearman")
## Print the results
print(correlation)
## With a p-value below 0.01, we reject the null, as there appears to be a
## correlation. With a rho value of 0.579, there is a moderate monotonic
## relationship.This means there appears to be a positive, but non-linear
## correlation between the variables.
# The code below creates a new data frame, 'model_df,' that includes the area,
# GDP per capita, population and population density for the twenty (20)
# countries of interest. All you should need to do is execute this code, as is.
# You do not need to add code in this chunk. You will need to add code in the
# 'regression_b,' 'regression_c' and 'regression_d' code chunks.
twenty_countries <- c("Austria", "Belgium", "Bulgaria", "Cyprus", "Denmark",
"Finland", "France", "Germany", "Hungary", "Ireland",
"Latvia", "Lithuania", "Malta", "Norway", "Poland",
"Portugal", "Romania", "Slovakia", "Spain", "Sweden")
sq_km <- c(83858, 30510, 110994, 9251, 44493, 338145, 551695, 357386, 93030,
70273, 64589, 65300, 316, 385178, 312685, 88416, 238397, 49036,
498511, 450295)
gdp_pps <- c(128, 118, 51, 91, 129, 111, 104, 123, 71, 190, 69, 81, 100, 142,
71, 78, 65, 71, 91, 120)
model_df <- data %>%
select(c(countriesAndTerritories, popData2020)) %>%
filter(countriesAndTerritories %in% twenty_countries) %>%
distinct(countriesAndTerritories, .keep_all = TRUE) %>%
add_column(sq_km, gdp_pps) %>%
mutate(pop_dens = popData2020 / sq_km) %>%
rename(country = countriesAndTerritories, pop = popData2020)
## Summarize total new cases for each country
total_cases <- data %>%
filter(countriesAndTerritories %in% twenty_countries) %>%
group_by(countriesAndTerritories) %>%
summarise(total_cases = sum(cases, na.rm = TRUE))
## Join the total new cases
model_df <- model_df %>%
left_join(total_cases, by = c("country" = "countriesAndTerritories"))
## Print the updated model
print(model_df)
## Fit the regression model
model <- lm(total_cases ~ pop + pop_dens + gdp_pps, data = model_df)
## Print the summary of the model
summary(model)
## Our model uses population, population density, and GDP for the model, but if
## we used an alpha value of 0.05, only population has a p-value smaller. This
## would be the only statistically significant predictor, and it may be worth
## dropping the rest if we wanted to predict total cases. Our R2 is high, listed
## at 0.8982, and the overall model has a p-value that would satisfy our alpha.
## Even with the some potentially excess predictors, in terms of statistical
## significance, the overall model may work to predict total cases. It would be
## worth comparing with the simpler model.
# The code below defines our 'newdata' data frame for applying our model to the
# population, population density and GDP per capita for two (2). Please execute
# the code as given.
newdata <- data.frame(country = c("Luxembourg", "Netherlands"),
pop = c(626108, 17407585),
gdp_pps = c(261, 130),
pop_dens = c(626108, 17407585) / c(2586, 41540))
# Add code here returning the actual  total cases from our dataset for the
# Netherlands and Luxembourg.
actual_total_cases <- data %>%
filter(countriesAndTerritories %in% c("Luxembourg", "Netherlands")) %>%
group_by(countriesAndTerritories) %>%
summarise(actual_total_cases = sum(cases, na.rm = TRUE))
## Print the value
print(actual_total_cases)
# Add code here returning the total cases for the Netherlands and Luxembourg
# predicted by our model.
## Use the model to predict total new cases
predicted_total_cases <- predict(model, newdata = newdata)
## Print the predictions
print(predicted_total_cases)
## The prediction for Luxembourg was poor, but it was close for the Netherlands
## Luxembourg had 301,031 cases, but a whopping 3,953,237 cases were predicted
## The Netherlands had 8,494,705 cases, with 7,522,800 cases predicted
## The model would have worked reasonably well for the Netherlands, but if used
## for Luxembourg we would greatly overstate how many cases we'd expect.
## Compare predictions to actuals
comparison <- newdata %>%
left_join(actual_total_cases, by = c("country" = "countriesAndTerritories"))
## View the comparison
print(comparison)
## Evaluate the residuals
comparison <- comparison %>%
mutate(residuals = actual_total_cases - predicted_total_cases)
print(comparison)
## The residulas are rather large, making it likely the model is not very useful
