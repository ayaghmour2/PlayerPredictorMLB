#'   xera = 3.55,
#'   xfip = 4.09,
#'   ip = 132.2,
#'   lob_pct = 73.3,
#'   k_pct = 28.7,
#'   bb_pct = 6.5,
#'   barrel_pct = 9.9,
#'   hardhit_pct = 36.9,
#'   is_starter = 1,
#'   is_reliever = 1
#' )
#' swingman_example
#'
#' @export
predict_fip <- function(
age,
babip,
hr_fb,
xera,
xfip,
ip,
lob_pct,
k_pct,
bb_pct,
barrel_pct,
hardhit_pct,
is_starter,
is_reliever,
data = Pitching
) {
.predict_pitching_stat(
age = age,
babip = babip,
hr_fb = hr_fb,
xera = xera,
xfip = xfip,
ip = ip,
lob_pct = lob_pct,
k_pct = k_pct,
bb_pct = bb_pct,
barrel_pct = barrel_pct,
hardhit_pct = hardhit_pct,
is_starter = is_starter,
is_reliever = is_reliever,
outcome = "FIP",
primary_stat = "xFIP",
data = data
)
}
